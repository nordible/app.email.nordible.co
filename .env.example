# =============================================================================
# Nordible Email Mobile App Environment Configuration
# =============================================================================

# Push Notification Relay Service
EXPO_PUBLIC_RELAY_BASE_URL=https://email-notifications.nordible.co

# Default Mail Server (All tenants run on this Stalwart server)
EXPO_PUBLIC_DEFAULT_HOST=mail1.nordible.co

# Webmail URL
EXPO_PUBLIC_WEBMAIL_URL=https://mailapp1.nordible.co

# Source Code URL
SOURCE_CODE_URL=https://github.com/nordible/app.email.nordible.co

# Apple Developer Credentials
APPLE_TEAM_ID=
# IOS_BUILD_NUMBER=1
# APS_ENVIRONMENT=production
